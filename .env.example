# Copy to .env and fill in. Never commit .env.

# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# https://aistudio.google.com/apikey  (free tier is fine; rate limits are handled with backoff)
GEMINI_API_KEY=

# Ollama runs locally and ignores the key; leave as-is.
OLLAMA_API_KEY=ollama

# Optional overrides
# ARBITER_CONFIG=config.yaml
# ARBITER_DB_PATH=data/arbiter.db
